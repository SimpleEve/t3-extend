<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <application>
    <!-- Not exported: the connector's exported MessagingReceiverImpl takes the broadcast and binds here in-app. -->
    <service android:name=".T3xPushService" android:exported="false">
      <intent-filter>
        <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
      </intent-filter>
    </service>
  </application>
</manifest>
