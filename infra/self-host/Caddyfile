# T3_DOMAIN、NTFY_DOMAIN 和 ACME_EMAIL 来自 docker-compose.yml 的环境变量（.env）。
{
	email {$ACME_EMAIL}
}

{$T3_DOMAIN} {
	# frps 的 tcp 代理把这个端口原样转发到家里电脑上的 T3 server。
	reverse_proxy frps:7001 {
		# Caddy 默认保留原始 Host，并设置 X-Forwarded-For / X-Forwarded-Proto / X-Forwarded-Host。
		# T3 server 用 Host 和 X-Forwarded-Proto 推导 OAuth issuer，不要改写它们。
		# 流式响应（SSE、推流）立即下发，不缓冲。
		flush_interval -1
		# 重载配置时给已建立的 WebSocket 一点时间，避免所有设备同时掉线。
		stream_close_delay 5m
	}

	# 不在这里加 basic auth：T3 的配对页、/.well-known 和 /oauth/token 必须能直接访问。
	# 认证由 T3 server 负责（一次性配对码 + 可撤销会话 + 失败限速）。
}

# UnifiedPush 推送服务器 ntfy，用独立域名。T3 Extend 所在的电脑向它 POST 加密后的通知，手机上的 ntfy 应用订阅它。
# 访问控制由 ntfy 自己负责（匿名不能读，匿名只能写 up 开头的主题），所以这里同样不加 basic auth。
{$NTFY_DOMAIN} {
    reverse_proxy ntfy:80 {
        # 手机上的 ntfy 应用靠长连接（WebSocket / 流式响应）收消息，不能缓冲。
        flush_interval -1
    }
}
