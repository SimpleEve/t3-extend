# T3X_DOMAIN and ACME_EMAIL come from docker-compose.yml (.env). The T3X_* upstream addresses differ from their
# defaults only with docker-compose.host-network.yml, where Caddy reaches the other services on 127.0.0.1.
{
	# setup.sh mounts caddy/acme-email.caddy (email {$ACME_EMAIL}), or the empty acme-email-off.caddy without --email.
	import /etc/caddy/acme-email.caddy
	# Certificates for computers' subdomains are requested on first visit, and only for registered names.
	on_demand_tls {
		ask http://{$T3X_REGISTRY_ASK:registry:8082}/ask
	}
	# Global options that other websites need (default_sni, ...); a directory without any is fine.
	import /etc/caddy/sites/*.options
}

{$T3X_DOMAIN} {
	# The tunnel control connection: frpc speaks websocket over TLS to this path.
	@frp path /~!frp
	handle @frp {
		reverse_proxy {$T3X_FRPS_CONTROL:frps:7000}
	}

	handle /v1/* {
		reverse_proxy {$T3X_REGISTRY_API:registry:8080} {
			# Overwrites whatever the client sent: this is the only address the registry rate-limits on.
			header_up X-T3x-Client-IP {remote_host}
		}
	}

	handle {
		respond 404
	}
}

# The push server (or nothing, with --no-ntfy).
import /etc/caddy/ntfy.caddy

# Every computer's own subdomain: <name>.<domain> goes to frps, which routes by Host. The address is the wildcard and
# not a bare `https://`: an on-demand site that matches every name also takes the certificate lookup of a client that
# sends no SNI, and then `default_sni` (a *.options file) cannot find the certificate it points at. The price: the
# wildcard covers ntfy.<domain>, so Caddy no longer obtains that name at startup and, unless its own site is also
# on-demand (caddy/ntfy.caddy says `tls { on_demand }`), never at all: a name listed in an ordinary managed policy is
# not put to `ask` at a handshake. The registry's `ask` says yes to ntfy when the push server is installed.
*.{$T3X_DOMAIN} {
	tls {
		on_demand
	}
	reverse_proxy {$T3X_FRPS_VHOST:frps:8080} {
		# Streaming responses (SSE) go out immediately.
		flush_interval -1
		header_up X-T3x-Client-IP {remote_host}
	}
}

# The other websites on this server, one file each (see ../sites/README.md); a directory without any is fine.
import /etc/caddy/sites/*.caddy
