# 复制为 .env 后修改。不要把 .env 提交到 git。
# 指向这台 VPS 的域名（A 记录）。
T3_DOMAIN=t3.example.com
# 推送服务器 ntfy 的域名，也要加一条指向这台 VPS 的 A 记录。
NTFY_DOMAIN=ntfy.example.com
# Let's Encrypt 用来发证书到期提醒的邮箱。
ACME_EMAIL=you@example.com
# frpc 和 frps 之间的共享密钥。用 `openssl rand -hex 32` 生成一个随机值。
FRP_AUTH_TOKEN=replace-with-a-long-random-string
