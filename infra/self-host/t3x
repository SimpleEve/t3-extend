#!/usr/bin/env bash
# 管理这台服务器上的设备。在 VPS 上、docker-compose.yml 所在的目录里运行。
#
#   ./t3x invite [--kind computer|phone|any]   一次性邀请，15 分钟内有效
#   ./t3x devices                              列出设备
#   ./t3x revoke <名字|id>                     移除一台设备
#   ./t3x invites                              列出还没用掉的邀请
#   ./t3x rename <名字> <新名字>               改显示名
#   ./t3x release <子域名>                     收回已移除电脑的子域名
#   ./t3x ntfy                                 手机推送应用要用的地址和账号
#   ./t3x info                                 注册表 id 和设备数
#
# T3X_DATA_DIR、T3X_COMPOSE_FILES 和 T3X_PROJECT 的含义和 setup.sh 一样。
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
DATA_DIR=${T3X_DATA_DIR:-$SCRIPT_DIR}
PROJECT=${T3X_PROJECT:-t3x}
COMPOSE_FILES=${T3X_COMPOSE_FILES:-docker-compose.yml}

[ -f "$DATA_DIR/.env" ] || {
  echo "错误：没找到 $DATA_DIR/.env。先运行 ./setup.sh。" >&2
  exit 1
}

if [ "${1:-}" = ntfy ]; then
  url=$(sed -n 's/^T3X_NTFY_URL=//p' "$DATA_DIR/.env")
  profiles=$(sed -n 's/^COMPOSE_PROFILES=//p' "$DATA_DIR/.env")
  case "$profiles" in
    *ntfy*) ;;
    *)
      echo "这台服务器没有装推送服务器（setup.sh 是带 --no-ntfy 运行的）。" >&2
      exit 1
      ;;
  esac
  echo "服务器：$url"
  echo "账号：  phone（对 up* 只读）"
  echo "密码：  $(tr -d '\n' <"$DATA_DIR/secrets/ntfy-phone.txt")"
  exit 0
fi

compose_args=(-p "$PROJECT" --env-file "$DATA_DIR/.env")
IFS=: read -r -a files <<<"$COMPOSE_FILES"
for file in "${files[@]}"; do
  compose_args+=(-f "$SCRIPT_DIR/$file")
done

tty_args=()
[ -t 0 ] && [ -t 1 ] || tty_args=(-T)
exec docker compose "${compose_args[@]}" exec "${tty_args[@]}" registry node /app/cli.mjs "$@"
