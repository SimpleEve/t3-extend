ntfy.{$T3X_DOMAIN} {
	# Without this the name would sit in an ordinary managed policy (listed before the on-demand wildcard): not obtained
	# at startup because the wildcard covers it, and not put to `ask` at a handshake either, so it would never get a
	# certificate. With it, the first visit asks the registry, which says yes to ntfy when the push server is installed.
	tls {
		on_demand
	}
	reverse_proxy {$T3X_NTFY_UPSTREAM:ntfy:80} {
		# The phone holds a long-lived connection; do not buffer it.
		flush_interval -1
	}
}
